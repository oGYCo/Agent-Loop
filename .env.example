# =============================================================================
# Agent-Loop Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values

# ============================================
# Required: API Authentication
# ============================================

# API token for authentication (required)
ANTHROPIC_AUTH_TOKEN=your-api-token-here

# API endpoint URL (optional, defaults to MiniMax)
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# ============================================
# Logging Configuration
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional, leave empty for console only)
LOG_FILE=/app/logs/agent.log

# Use JSON format for logs (true/false)
LOG_JSON=false

# Audit log file path
AUDIT_LOG_FILE=logs/audit.log

# ============================================
# API Server Configuration
# ============================================

# API server port
PORT=8000

# API server host
API_HOST=0.0.0.0

# Enable debug mode (shows detailed errors)
DEBUG=false

# ============================================
# Email Notifications (optional)
# ============================================

# SMTP password (if not using config.json)
# SMTP_PASSWORD=your-smtp-password

# ============================================
# Grafana Configuration (optional)
# ============================================

# Grafana admin username
GRAFANA_USER=admin

# Grafana admin password
GRAFANA_PASSWORD=admin

# Grafana root URL (for reverse proxy)
# GRAFANA_ROOT_URL=http://localhost:3000

# ============================================
# Project-Specific Configuration
# ============================================

# Project directory (if not current directory)
# PROJECT_DIR=/path/to/project
